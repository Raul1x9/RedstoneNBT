<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RedstoneNBT.Views.RenameTagWindow"
        Title="Rename Tag"
        Width="400" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Rename Tag" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="New Name:" FontWeight="SemiBold"/>
            <TextBox x:Name="NameTextBox" PlaceholderText="Enter tag name" TextChanged="NameTextBox_TextChanged"/>
            <TextBlock x:Name="ErrorText" Foreground="#FF5555" FontSize="11" IsVisible="False"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" HorizontalContentAlignment="Center" Click="OkButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" HorizontalContentAlignment="Center" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
