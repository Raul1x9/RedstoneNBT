<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NBTReborn.Views.CreateTagWindow"
        Title="Add Tag"
        Width="440" Height="280"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" Text="Add New Tag" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock x:Name="SubtitleText" Text="Tag Type" Opacity="0.7" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="10" VerticalAlignment="Center">
            <!-- Tag Name (for Named Containers) -->
            <StackPanel x:Name="NamePanel" Spacing="4">
                <TextBlock Text="Name:" FontWeight="SemiBold"/>
                <TextBox x:Name="NameTextBox" PlaceholderText="Enter tag name" TextChanged="Input_Changed"/>
            </StackPanel>

            <!-- Tag Value (for Scalar Types) -->
            <StackPanel x:Name="ValuePanel" Spacing="4">
                <TextBlock Text="Initial Value:" FontWeight="SemiBold"/>
                <TextBox x:Name="ValueTextBox" PlaceholderText="Enter initial value" TextChanged="Input_Changed"/>
            </StackPanel>

            <!-- List Subtype Picker (for List Types) -->
            <StackPanel x:Name="ListTypePanel" Spacing="4" IsVisible="False">
                <TextBlock Text="Child Element Type:" FontWeight="SemiBold"/>
                <ComboBox x:Name="ListTypeComboBox" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#FF5555" FontSize="11" IsVisible="False"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" HorizontalContentAlignment="Center" Click="OkButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" HorizontalContentAlignment="Center" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
