<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NBTReborn.Views.AboutWindow"
        Title="About NBTReborn"
        Width="380" Height="220"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20" RowDefinitions="*,Auto">
        <StackPanel Grid.Row="0" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="NBTReborn" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Modern Cross-Platform NBT Explorer for Linux, Windows, &amp; macOS" FontSize="12" Opacity="0.8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="Revived from Justin Aquadro's classic NBTExplorer" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
            <TextBlock Text="Built with .NET 10 &amp; Avalonia UI" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
        </StackPanel>

        <Button Grid.Row="1" Content="Close" Width="80" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Click="CloseButton_Click" IsDefault="True"/>
    </Grid>
</Window>
